# Copia este archivo como .env y completa solo los valores que uses.
# Nunca guardes secretos reales en esta plantilla ni en Git.

VITE_API_BASE_URL=http://localhost:5168

# Acceso local del dashboard.
DASHBOARD_ADMIN_PASSWORD=

# Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=30

# Google Search Console OAuth 2.0 (solo lectura).
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=http://localhost:5168/api/integrations/search-console/callback
DASHBOARD_WEB_BASE_URL=http://localhost:5173
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=

# Gemini y WordPress.
GEMINI_API_KEY=
WORDPRESS_BASE_URL=https://fyrstudios.com/
WORDPRESS_USERNAME=dashboard-bot
WORDPRESS_APPLICATION_PASSWORD=

# X API v2. Solo lectura en la fase 7E; su uso puede consumir créditos de pago.
X_BEARER_TOKEN=

# PostHog Cloud: clave personal restringida al proyecto y permiso query:read.
# El ID del proyecto y token público phc_... se configuran en Marketing → PostHog.
POSTHOG_PERSONAL_API_KEY=

# n8n llamará a la API local mediante un secreto independiente.
N8N_WEBHOOK_SECRET=
